  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "firebase": "^10.13.0",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "firebase-tools": "^15.26.0",
    "vite": "^5.4.1"
  }
}
