{
  "name": "ai-riser-family-health",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "VITE_HTTPS=true vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "deploy": "npm run build && python3 scripts/deploy.py",
